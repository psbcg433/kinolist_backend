# =============================================================================
# KinoList Microservices — root .env.example
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
#   cp .env.example .env
#
# Generate the JWT access key pair once and reuse the same values across the
# services that need them:
#   node scripts/generate-jwt-keys.mjs
# =============================================================================

# -----------------------------------------------------------------------------
# Node / deployment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# JWT access-token material (Auth signs; protected services verify)
#   - Prefer RS256 (asymmetric): generate with `node scripts/generate-jwt-keys.mjs`
#   - HS256 fallback: set JWT_ALGORITHM=HS256 and JWT_ACCESS_SECRET instead
# -----------------------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_SECRET=

JWT_ACCESS_TTL=15m
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# -----------------------------------------------------------------------------
# Auth-only secrets (NEVER distributed to other services)
# -----------------------------------------------------------------------------
CSRF_SECRET=
TOTP_ENCRYPTION_KEY=

# Email-delivered, one-time 2FA QR challenges through Gmail SMTP.
TWO_FACTOR_CODE_TTL_SECONDS=300
TWO_FACTOR_CODE_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Refresh cookie behaviour. COOKIE_SECURE must be false when serving over
# plain HTTP (local development); true in production behind TLS.
COOKIE_NAME=kinolist_refresh
COOKIE_PATH=/api
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# External providers
# -----------------------------------------------------------------------------
OMDB_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TASTEDIVE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Internal service-to-service token (only for trusted internal HTTP contracts)
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Service ports (host-facing only the gateway; others internal by default)
# -----------------------------------------------------------------------------
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
PROFILE_SERVICE_PORT=5002
LIBRARY_SERVICE_PORT=5003
MOVIE_SERVICE_PORT=5004
DISCOVERY_SERVICE_PORT=5005

# -----------------------------------------------------------------------------
# Frontend origin(s) allowed by the gateway CORS (comma separated)
# -----------------------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to a hop count or comma-separated trusted proxy CIDRs in deployments.
# Never use an unrestricted true/* value.
TRUST_PROXY=false

# Shared Redis Stream names
REDIS_STREAM=kinolist:stream:domain-events
REDIS_DLQ=kinolist:stream:domain-events:dlq

# Gateway limits
MAX_BODY_BYTES=10485760
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
UPSTREAM_TIMEOUT_MS=15000

# Auth/session limits
SESSION_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_2FA_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_DELETE_ACCOUNT_MAX=5
BCRYPT_ROUNDS=12

# Domain service limits and provider timeouts
MAX_IMAGE_BYTES=5242880
MAX_ITEMS_PER_PLAYLIST=500
OMDB_BASE_URL=https://www.omdbapi.com
OMDB_TIMEOUT_MS=8000
MOVIE_CACHE_TTL_SECONDS=86400
MOVIE_DB_MAX_AGE_SECONDS=604800
MOVIE_STALE_IF_ERROR_SECONDS=3600
MOVIE_BATCH_CONCURRENCY=4
INTERNAL_TIMEOUT_MS=8000
TASTEDIVE_BASE_URL=https://tastedive.com/api/similar
TASTEDIVE_TIMEOUT_MS=8000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_MS=15000
DISCOVERY_FEED_CACHE_TTL=21600
DISCOVERY_RECOMMEND_CACHE_TTL=1800
SEARCH_HISTORY_CAP=50
MAX_AI_RESULTS=5
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=5
MAX_RECOMMEND_RESOLVE=8
FEED_ENRICH_LIMIT=12
FEED_RESOLVE_PER_SEED=2
TRENDING_WINDOW_DAYS=30
