{
  "info": {
    "_postman_id": "75ea9054-61bb-4df4-9b91-21aec3c255a7",
    "name": "KinoList Microservices - API Gateway",
    "description": "Complete gateway-facing KinoList API collection. Every request uses {{gatewayUrl}}; service-only internal routes are intentionally excluded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let body = null;",
          "try { body = pm.response.json(); } catch (_err) {}",
          "if (body) {",
          "  const data = body.data || {};",
          "  const accessToken = data.accessToken;",
          "  const csrfToken = data.csrfToken;",
          "  const user = data.user;",
          "  const challengeId = data.challengeId;",
          "  if (accessToken) pm.environment.set('accessToken', accessToken);",
          "  if (csrfToken) pm.environment.set('csrfToken', csrfToken);",
          "  if (user && user.id) pm.environment.set('userId', user.id);",
          "  if (challengeId) pm.environment.set('challengeId', challengeId);",
          "  if (body.success === true) {",
          "    pm.test('uses the standard success envelope', () => {",
          "      pm.expect(Object.keys(body).sort()).to.eql(['data', 'meta', 'requestId', 'success']);",
          "      pm.expect(body.data).to.be.an('object');",
          "      pm.expect(body.meta).to.be.an('object');",
          "    });",
          "  } else if (body.success === false) {",
          "    pm.test('uses the standard error envelope', () => {",
          "      pm.expect(Object.keys(body).sort()).to.eql(['error', 'requestId', 'success']);",
          "      pm.expect(body.error).to.have.keys(['code', 'details', 'message']);",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
