    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{displayName}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/auth/register",
            "description": "Creates an account only and returns registered=true. It intentionally issues no access, refresh, or CSRF credentials; run Login next. Change email before rerunning."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/auth/login",
            "description": "Captures credentials when 2FA is disabled. When enabled, sends a short-lived QR email and captures challengeId; no token is issued until verification."
          },
          "response": []
        },
        {
          "name": "Verify 2FA login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{twoFactorCode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/auth/2fa/login/verify"
          },
          "response": []
        },
        {
          "name": "Get CSRF token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/auth/csrf",
            "description": "Uses the refresh cookie from Postman's cookie jar and captures csrfToken."
          },
          "response": []
        },
        {
          "name": "Refresh access token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": "{{gatewayUrl}}/api/v1/auth/refresh",
            "description": "Uses and rotates the refresh cookie, then captures the new access and CSRF tokens."
          },
          "response": []
        },
        {
          "name": "Current auth user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/auth/me"
          },
          "response": []
        },
        {
          "name": "List sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const sessions = body.data && body.data.sessions;",
                  "if (sessions && sessions.length) {",
                  "  const target = sessions.find((session) => !session.current) || sessions[0];",
                  "  pm.environment.set('sessionId', target.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/auth/sessions",
            "description": "Captures a non-current session when available, otherwise the current session."
          },
          "response": []
        },
        {
          "name": "Revoke one session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/auth/sessions/{{sessionId}}",
            "description": "May revoke the current session when only one session exists."
          },
          "response": []
        },
        {
          "name": "Begin 2FA setup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/auth/2fa/setup",
            "description": "Requires current-password reauthentication, emails a short-lived QR to the registered address, and captures challengeId. No QR or code is returned by the API."
          },
          "response": []
        },
        {
          "name": "Verify 2FA setup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{twoFactorCode}}\"\n}",
