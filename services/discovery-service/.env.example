# KinoList Discovery Service configuration
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=5005

MONGO_URI=mongodb://mongo-discovery:27017/kinolist_discovery
REDIS_URL=redis://redis:6379

# Shared secret for service-to-service calls to /internal/* endpoints.
INTERNAL_API_KEY=

# Peer services (Docker Compose DNS). All OMDb metadata flows through movie-service.
MOVIE_SERVICE_URL=http://movie-service:5004
LIBRARY_SERVICE_URL=http://library-service:5003
INTERNAL_TIMEOUT_MS=8000

# TasteDive recommendations provider
TASTEDIVE_API_KEY=
TASTEDIVE_BASE_URL=https://tastedive.com/api/similar
TASTEDIVE_TIMEOUT_MS=8000

# OpenRouter (AI search)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=15000

# Access-token verification material (public key only).
JWT_ALGORITHM=RS256
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_SECRET=
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# Redis Streams event bus
REDIS_STREAM=kinolist:stream:domain-events
REDIS_DLQ=kinolist:stream:domain-events:dlq

# Caches (seconds)
DISCOVERY_FEED_CACHE_TTL=21600
DISCOVERY_RECOMMEND_CACHE_TTL=1800

# Limits
SEARCH_HISTORY_CAP=50
MAX_AI_RESULTS=5
MAX_RECOMMEND_RESOLVE=8
