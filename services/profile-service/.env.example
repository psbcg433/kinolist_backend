# KinoList Profile Service configuration
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=5002

MONGO_URI=mongodb://mongo-profile:27017/kinolist_profile
REDIS_URL=redis://redis:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Access-token verification material (public key only — this service must never
# receive signing/refresh/CSRF/TOTP secrets).
JWT_ALGORITHM=RS256
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_SECRET=
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# Redis Streams event bus
REDIS_STREAM=kinolist:stream:domain-events
REDIS_DLQ=kinolist:stream:domain-events:dlq

# Upload limits (server-side enforcement)
MAX_IMAGE_BYTES=5242880
