# KinoList Library Service configuration
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=5003

MONGO_URI=mongodb://mongo-library:27017/kinolist_library
REDIS_URL=redis://redis:6379

# Access-token verification material (public key only — this service must never
# receive signing/refresh/CSRF/TOTP secrets).
JWT_ALGORITHM=RS256
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_SECRET=
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# Shared secret for service-to-service calls to /internal/* endpoints.
INTERNAL_API_KEY=

# Redis Streams event bus
REDIS_STREAM=kinolist:stream:domain-events
REDIS_DLQ=kinolist:stream:domain-events:dlq

MAX_ITEMS_PER_PLAYLIST=500
