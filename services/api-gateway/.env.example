# KinoList API Gateway configuration
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=5000

REDIS_URL=redis://redis:6379

# Internal service DNS for Docker Compose
AUTH_SERVICE_URL=http://auth-service:5001
PROFILE_SERVICE_URL=http://profile-service:5002
LIBRARY_SERVICE_URL=http://library-service:5003
MOVIE_SERVICE_URL=http://movie-service:5004
DISCOVERY_SERVICE_URL=http://discovery-service:5005

# Comma separated list of allowed browser origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum accepted request body size (bytes) before rejection
MAX_BODY_BYTES=10485760

# Rate limiting (requests per window per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Upstream timeout (ms)
UPSTREAM_TIMEOUT_MS=15000

# Access-token verification material. The gateway only ever proxies the
# Authorization header; it does not sign tokens. Supplied so the /health/ready
# probe can validate configuration consistency.
JWT_ALGORITHM=RS256
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_SECRET=
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# Internal service-to-service token (used only if a future internal route needs it)
INTERNAL_SERVICE_TOKEN=
