# KinoList Auth Service configuration
# Copy to .env and fill in. Never commit real secrets.
#
# Generate the JWT access key pair:
#   node ../../scripts/generate-jwt-keys.mjs
# Auth signs access tokens with the private key; protected services verify with the public key.

NODE_ENV=development
PORT=5001

MONGO_URI=mongodb://mongo-auth:27017/kinolist_auth
REDIS_URL=redis://redis:6379

# Access-token signing (RS256 preferred)
JWT_ALGORITHM=RS256
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=

# HS256 fallback: set JWT_ALGORITHM=HS256 and JWT_ACCESS_SECRET instead
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# Auth-only secrets — never distributed to other services
CSRF_SECRET=
TOTP_ENCRYPTION_KEY=

# Short-lived email QR challenges
TWO_FACTOR_CODE_TTL_SECONDS=300
TWO_FACTOR_CODE_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Session / refresh-token lifetime
SESSION_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie
COOKIE_NAME=kinolist_refresh
COOKIE_PATH=/api
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis Streams event bus
REDIS_STREAM=kinolist:stream:domain-events
REDIS_DLQ=kinolist:stream:domain-events:dlq

# Rate limiting (per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_2FA_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_DELETE_ACCOUNT_MAX=5

BCRYPT_ROUNDS=12
