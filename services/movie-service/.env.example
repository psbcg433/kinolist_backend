# KinoList Movie Service configuration
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=5004

MONGO_URI=mongodb://mongo-movie:27017/kinolist_movie
REDIS_URL=redis://redis:6379

OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com
OMDB_TIMEOUT_MS=8000
MOVIE_CACHE_TTL_SECONDS=86400
MOVIE_DB_MAX_AGE_SECONDS=604800
MOVIE_STALE_IF_ERROR_SECONDS=3600
MOVIE_BATCH_CONCURRENCY=4

# Access-token verification material (public key only).
JWT_ALGORITHM=RS256
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_SECRET=
JWT_ISSUER=kinolist-auth
JWT_AUDIENCE=kinolist-api

# Shared secret for service-to-service calls to /internal/* endpoints.
INTERNAL_API_KEY=
